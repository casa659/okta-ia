@page
@model OktaIA.Web.Pages.Admin.MarketplaceModel
@using OktaIA.Web.Services
@{
    ViewData["Title"] = "Marketplace";
    // As três contagens saem do estado REAL de cada item (adaptador escrito + instalado por
    // alguma empresa), nunca de um campo "status" digitado na lista. Ver MarketplaceModel.Situacao.
    var instalados = AdminCatalog.Market.Count(m => Model.Situacao(m.Slug).Rotulo == "instalado");
    var prontos = AdminCatalog.Market.Count(m => Model.Situacao(m.Slug).Rotulo == "pronto para instalar");
    var semConector = AdminCatalog.Market.Count(m => Model.Situacao(m.Slug).Rotulo == "sem conector");
}

<div style="display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:16px; flex-wrap:wrap;">
    <div class="adm-page-head" style="margin-bottom:0;">
        <h1>Marketplace de integrações</h1>
        <p>Instale, atualize e remova conectores sem tocar no núcleo da plataforma</p>
    </div>
    <div style="display:flex; gap:9px;">
        <span class="adm-pill" style="color:#00E0A4; background:#00E0A41A;">@instalados INSTALADO(S)</span>
        <span class="adm-pill" style="color:#4D9BFF; background:#4D9BFF1A;">@prontos PRONTO(S)</span>
        <span class="adm-pill" style="color:#7A8FAB; background:rgba(120,170,255,.07);">@semConector SEM CONECTOR</span>
    </div>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(236px,100%),1fr)); gap:11px;">
    @foreach (var m in AdminCatalog.Market)
    {
        var sit = Model.Situacao(m.Slug);
        var trustColor = m.Trust switch { "oficial" => "#00E0A4", "verificado" => "#4D9BFF", _ => "#7A8FAB" };
        <div class="adm-card" style="padding:16px 17px; display:flex; flex-direction:column;">
            <div style="display:flex; align-items:flex-start; gap:11px; margin-bottom:11px;">
                <span style="width:32px; height:32px; border-radius:8px; background:rgba(77,155,255,.11); border:1px solid rgba(120,170,255,.16); display:flex; align-items:center; justify-content:center; font-family:'IBM Plex Mono',monospace; font-size:11px; font-weight:600; color:#8FC0FF; flex:0 0 32px;">@m.Ini</span>
                <div style="flex:1; min-width:0;">
                    <div style="font-size:13px; font-weight:600; letter-spacing:-.012em; line-height:1.3;">@m.N</div>
                    <div class="oi-mono" style="font-size:9px; color:#4A5D78; margin-top:3px;">@m.Cat</div>
                </div>
                <span class="adm-pill" style="color:@sit.Cor; background:@(sit.Cor)1F; font-size:8.5px;">@sit.Rotulo.ToUpperInvariant()</span>
            </div>
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:11px; flex-wrap:wrap;">
                <span class="adm-pill" style="color:@trustColor; background:@(trustColor)1F; font-size:8.5px;">@m.Trust.ToUpperInvariant()</span>

            </div>
            @* Quantas empresas usam de VERDADE. Antes dizia "2.1k instalações" para todo mundo. *@
            <div class="oi-mono" style="font-size:9px; color:#4A5D78; margin-top:auto;">
                @m.Vendor@(Model.EmpresasPorSlug.TryGetValue(m.Slug, out var qtd) ? $" · {qtd} empresa(s)" : "")
            </div>
            @{ var roteiro = OktaIA.Web.Services.Integracoes.CatalogoDeRoteiros.PorFabricante(m.N); }
            @if (roteiro is not null)
            {
                <div style="display:flex; gap:6px; margin-top:10px; padding-top:10px; border-top:1px solid rgba(120,170,255,.07); flex-wrap:wrap;">
                    <a asp-page-handler="RoteiroCliente" asp-route-fabricante="@m.N" class="adm-btn-ghost" style="font-size:10px; padding:6px 9px; text-decoration:none;">Roteiro do cliente</a>
                    <a asp-page-handler="RoteiroInterno" asp-route-fabricante="@m.N" class="adm-btn-ghost adm-accent" style="font-size:10px; padding:6px 9px; text-decoration:none;">Roteiro interno</a>
                </div>
                @if (!roteiro.Implementado)
                {
                    <div style="font-size:9.5px; color:#FF8A3D; margin-top:6px;">conector ainda não implementado — roteiro serve ao levantamento</div>
                }
            }
        </div>
    }
</div>
