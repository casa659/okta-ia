@page
@model OktaIA.Web.Pages.Admin.ModeloUnificadoModel
@using OktaIA.Web.Services
@{
    ViewData["Title"] = "Modelo unificado";
}

<div class="adm-page-head">
    <h1>Modelo de dados unificado</h1>
    <p>Todo fornecedor é traduzido para o mesmo esquema versionado · o núcleo nunca vê payload cru</p>
</div>

<div style="display:flex; flex-direction:column; gap:11px;">
    @foreach (var u in AdminCatalog.Unified)
    {
        <div class="adm-card" style="padding:17px 19px;">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:11px; flex-wrap:wrap;">
                <span style="font-size:15px; font-weight:600; letter-spacing:-.016em;">@u.N</span>
                <span class="oi-mono" style="font-size:10px; color:#00E0A4; background:rgba(0,224,164,.10); border:1px solid rgba(0,224,164,.24); border-radius:5px; padding:3px 8px;">@u.Schema</span>
                <span style="margin-left:auto;" class="oi-mono" style="font-size:9.5px; color:#5A7191;">@u.MappedCount campos mapeados</span>
            </div>
            <div class="oi-mono" style="font-size:11px; color:#8FC0FF; background:rgba(5,10,18,.5); border:1px solid rgba(120,170,255,.09); border-radius:8px; padding:11px 13px; margin-bottom:10px; line-height:1.6;">@u.Fields</div>
            <div style="display:flex; align-items:baseline; gap:9px;">
                <span class="oi-mono" style="font-size:8.5px; color:#4A5D78; letter-spacing:.1em;">FONTES</span>
                <span style="font-size:11.5px; color:#8296B0;">@u.Sources</span>
            </div>
        </div>
    }
</div>
