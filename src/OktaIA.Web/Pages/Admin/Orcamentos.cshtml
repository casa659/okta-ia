    .fraco { color:#8A96AB; font-size:12px; }
    .prop-pdf { display:inline-block; margin-top:8px; font-size:11px; font-weight:600; color:#3D7BFF; text-decoration:none; border:1px solid #3D7BFF; border-radius:999px; padding:4px 12px; }
    .prop-pdf:hover { background:rgba(61,123,255,.14); }
    .prop-precos { margin-top:16px; background:rgba(8,14,24,.6); border:1px solid rgba(120,170,255,.16); border-radius:12px; padding:14px 18px; }
    .prop-precos > summary { cursor:pointer; font-size:12px; text-transform:uppercase; letter-spacing:.1em; color:#8A96AB; }
    .prop-precos > summary:hover { color:#EAF0F8; }
    .prop-precos form { margin-top:14px; }
    .prop-link-precos { font-size:12px; color:#8A96AB; text-decoration:none; border:1px solid rgba(120,170,255,.2); border-radius:8px; padding:7px 12px; }
    .prop-link-precos:hover { color:#EAF0F8; border-color:rgba(120,170,255,.45); }
    .prop-desconto { display:grid; gap:8px; margin:12px 0; }
    .prop-desconto > div { background:rgba(5,10,18,.5); border-radius:8px; padding:9px 12px; display:flex; align-items:baseline; gap:10px; flex-wrap:wrap; }
    .prop-desconto span { font-size:10px; text-transform:uppercase; letter-spacing:.08em; color:#8A96AB; }
    .prop-desconto b { font-size:13px; }
    .prop-desconto i { font-style:normal; font-size:12px; color:#F5A34A; margin-left:auto; }
    .mono { font-family:ui-monospace,'Cascadia Mono',Menlo,monospace; }

    /* ⚠️ A VIA DO CLIENTE. `.naoimprime` some, o papel fica branco e a proposta ocupa a folha.
       É a mesma tela — sem segunda versão para envelhecer sozinha. */
    @@media print {
        .naoimprime, .adm-nav, .adm-topo, .adm-sidebar, nav, header, footer, .adm-page-head a { display:none !important; }
        .prop-grade { display:block; }
        body, .prop-papel { background:#fff !important; color:#111 !important; }
        .prop-papel { border:none; padding:0; }
        .prop-papel h2, .prop-resumo, .prop-inclui ul, .prop-obs p { color:#111 !important; }
        .prop-valores > div { border:1px solid #ccc !important; background:#fff !important; }
        .prop-valores > div.destaque { background:#f4f7fd !important; }
        .fraco, .prop-marca span, .prop-valores span, .prop-valores i { color:#555 !important; }
        .etiqueta { color:#1F5FE0 !important; }
    }
</style>

@section Scripts {
    <script src="~/js/orcamento.js" asp-append-version="true"></script>
}
