@page
@model EmpresaModel
@using OktaIA.Web.Services
@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "Empresa";
}

<section class="mk-section-tight" style="padding-top:80px; padding-bottom:56px; border-bottom:1px solid rgba(120,170,255,.09);">
  <span class="mk-kicker">A empresa</span>
  <h1 class="mk-h1">Engenharia de segurança construída dentro de ambientes críticos</h1>
  <p class="mk-lead">A L'okta IA nasceu da prática: anos operando sistemas que não podem cair, em hospitais, instituições financeiras, indústrias e órgãos públicos. Transformamos essa experiência em uma plataforma que qualquer organização pode adotar sem montar um SOC do zero.</p>
</section>

<section class="mk-section">
  <div class="mk-grid-3">
    <div class="mk-card">
      <div class="mk-mono" style="font-size:10.5px; color:#4D9BFF; letter-spacing:.16em; text-transform:uppercase; margin-bottom:16px;">Missão</div>
      <p style="margin:0; font-size:15px; line-height:1.7; color:#B4C4D8;">Reduzir o risco cibernético de organizações brasileiras a um patamar mensurável, com tecnologias integradas de parceiros e operação gerenciada contínua.</p>
    </div>
    <div class="mk-card">
      <div class="mk-mono" style="font-size:10.5px; color:#00E0A4; letter-spacing:.16em; text-transform:uppercase; margin-bottom:16px;">Visão</div>
      <p style="margin:0; font-size:15px; line-height:1.7; color:#B4C4D8;">Ser a plataforma de referência em Cyber Security com IA na América Latina, atendendo do pequeno provedor à instituição financeira.</p>
    </div>
    <div class="mk-card">
      <div class="mk-mono" style="font-size:10.5px; color:#8A7BFF; letter-spacing:.16em; text-transform:uppercase; margin-bottom:16px;">Valores</div>
      <p style="margin:0; font-size:15px; line-height:1.7; color:#B4C4D8;">Transparência técnica, responsabilidade sobre o dado do cliente, rigor de engenharia e comunicação sem alarmismo.</p>
    </div>
  </div>
</section>

<section class="mk-section-shaded">
  <div style="max-width:1280px; margin:0 auto; padding:clamp(44px,6vw,80px) clamp(16px,4vw,32px);">
    <div class="mk-lede-block" style="max-width:620px;">
      <span class="mk-kicker">Nossa experiência</span>
      <h2 class="mk-h2">Competência acumulada, não improvisada</h2>
      <p class="mk-lead">Nossa diretoria e nosso corpo técnico reúnem experiência prática em projetos corporativos de alta criticidade. Essa bagagem está embutida em cada decisão de arquitetura da plataforma.</p>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(212px,100%),1fr)); gap:12px;">
      @foreach (var e in MarketingContent.Expertise)
      {
        <div style="display:flex; align-items:center; gap:10px; background:rgba(255,255,255,.026); border:1px solid rgba(120,170,255,.10); border-radius:10px; padding:14px 16px;">
          <span style="width:5px; height:5px; border-radius:50%; background:#4D9BFF; flex:0 0 5px;"></span>
          <span style="font-size:13.5px; color:#B4C4D8; font-weight:500;">@e</span>
        </div>
      }
    </div>
  </div>
</section>

<section class="mk-section">
  <div class="mk-lede-block" style="max-width:620px;">
    <span class="mk-kicker">Compromissos</span>
    <h2 class="mk-h2">O que assumimos por contrato</h2>
  </div>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(288px,100%),1fr)); gap:16px;">
    @foreach (var c in MarketingContent.Commitments)
    {
      <div style="background:rgba(255,255,255,.028); border:1px solid rgba(120,170,255,.11); border-radius:14px; padding:24px 22px; border-top:2px solid @c.C;">
        <div style="font-size:15.5px; font-weight:600; margin-bottom:9px; letter-spacing:-.012em;">@c.T</div>
        <p style="margin:0; font-size:13.5px; line-height:1.66; color:#8296B0;">@c.D</p>
      </div>
    }
  </div>
</section>

<section class="mk-section-shaded">
  <div style="max-width:1280px; margin:0 auto; padding:clamp(40px,5vw,72px) clamp(16px,4vw,32px);">
    <div class="mk-lede-block" style="max-width:620px;">
      <span class="mk-kicker">Parceiros</span>
      <h2 class="mk-h2" style="margin-bottom:14px;">Ecossistema estratégico</h2>
      <p class="mk-lead">Trabalhamos junto de consultorias de LGPD, escritórios de advocacia, auditorias e integradores de nuvem. O programa de parceria inclui white label, comissionamento recorrente e suporte técnico dedicado.</p>
    </div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(212px,100%),1fr)); gap:14px;">
      @foreach (var p in MarketingContent.Partners)
      {
        <div style="background:rgba(255,255,255,.028); border:1px solid rgba(120,170,255,.11); border-radius:13px; padding:22px 20px;">
          <div class="mk-mono" style="font-size:10px; color:#00E0A4; letter-spacing:.12em; margin-bottom:12px;">@p.N</div>
          <div style="font-size:14.5px; font-weight:600; margin-bottom:7px;">@p.T</div>
          <div style="font-size:12.5px; line-height:1.6; color:#7A8FAB;">@p.D</div>
        </div>
      }
    </div>
  </div>
</section>
