@page
@using OktaIA.Web.Services
@inject I18nService I18n
@model RelatoriosModel
@{
    ViewData["Title"] = I18n.T("nav.rep");
}

<div class="oi-content">
    <div style="margin-bottom:14px;">
        <h1 class="oi-dash-title">@I18n.T("repTitle")</h1>
        <p class="oi-dash-sub">@I18n.T("repSub")</p>
    </div>

    <div class="oi-reports-grid">
        <div class="oi-report-cards">
            @foreach (var r in Model.Reports)
            {
                <div class="oi-report-card">
                    <div class="oi-report-top">
                        <span class="oi-report-fmt" style="color:@r.CorFormato;border-color:@r.CorFormato;background:@r.FundoFormato">@r.Formato</span>
                        <span class="oi-report-freq">@r.Frequencia</span>
                    </div>
                    <div class="oi-report-name">@r.Nome</div>
                    <p class="oi-report-desc">@r.Descricao</p>
                    <div class="oi-report-foot">
                        <span class="oi-report-last">@r.Ultimo</span>
                        @if (r.Disponivel)
                        {
                            @* O único relatório que existe é gerado na tela de Vulnerabilidades —
                               mandar pra lá em vez de exibir um "Gerar" que não gera nada. *@
                            <a asp-page="/Vulnerabilidades" class="oi-report-gen" style="text-decoration:none;">@I18n.T("generate") →</a>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="oi-exec-card">
            @* Sem o selo "AI": o texto é montado por consulta ao banco, não gerado por modelo.
               Alegar IA aqui seria mais uma afirmação que não se sustenta. *@
            <div class="oi-panel-head">
                <span class="oi-panel-title" style="margin:0">@I18n.T("execPreview")</span>
            </div>
            <div class="oi-exec-body">
                <div class="oi-exec-period">@Model.PeriodoRotulo</div>
                <h3 class="oi-exec-head">@Model.ResumoTitulo</h3>
                <p class="oi-exec-text">@Model.ResumoTexto</p>
                <div class="oi-exec-stats">
                    @foreach (var e in Model.ExecStats)
                    {
                        <div class="oi-exec-stat">
                            <div class="oi-exec-stat-k">@e.Chave</div>
                            <div class="oi-exec-stat-v" style="color:@e.Cor">@e.Valor</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
