@page
@using OktaIA.Web.Services
@inject I18nService I18n
@model RelatoriosModel
@{
    ViewData["Title"] = I18n.T("nav.rep");
}

<div class="oi-content">
    <div style="margin-bottom:14px;">
        <h1 class="oi-dash-title">@I18n.T("repTitle")</h1>
        <p class="oi-dash-sub">@I18n.T("repSub")</p>
    </div>

    @* ── Relatório mensal por cliente ────────────────────────────────────────────────────
       É o documento que justifica a mensalidade: monitoramento bem feito é invisível, e serviço
       que não se vê é o primeiro a ser cortado. Fica no ALTO da tela, e não no meio dos cartões
       de modelo, porque é o único aqui que produz um arquivo de verdade. *@
    @if (Model.EmpresasMonitoradas.Count > 0)
    {
        <form method="get" class="oi-relmes">
            <input type="hidden" name="handler" value="Mensal" />
            <div class="oi-relmes-tit">Relatório mensal do cliente</div>

            <select name="empresa" required>
                @foreach (var e in Model.EmpresasMonitoradas)
                {
                    <option value="@e.Id">@e.Nome</option>
                }
            </select>

            @{
                var mesPadrao = DateTime.Today.AddMonths(-1);
            }
            <select name="mes">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m" selected="@(m == mesPadrao.Month)">
                        @System.Globalization.CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetMonthName(m)
                    </option>
                }
            </select>

            <select name="ano">
                @for (var y = DateTime.Today.Year; y >= DateTime.Today.Year - 2; y--)
                {
                    <option value="@y" selected="@(y == mesPadrao.Year)">@y</option>
                }
            </select>

            <button type="submit">Gerar PDF</button>
            @* O mês anterior vem escolhido: emitido no dia 6, "este mês" mostraria seis dias e
               pareceria um mês vazio. *@
            <span class="oi-relmes-nota">O mês anterior vem selecionado — é o que se fecha.</span>
        </form>
    }

    <div class="oi-reports-grid">
        <div class="oi-report-cards">
            @foreach (var r in Model.Reports)
            {
                <div class="oi-report-card">
                    <div class="oi-report-top">
                        <span class="oi-report-fmt" style="color:@r.CorFormato;border-color:@r.CorFormato;background:@r.FundoFormato">@r.Formato</span>
                        <span class="oi-report-freq">@r.Frequencia</span>
                    </div>
                    <div class="oi-report-name">@r.Nome</div>
                    <p class="oi-report-desc">@r.Descricao</p>
                    <div class="oi-report-foot">
                        <span class="oi-report-last">@r.Ultimo</span>
                        @if (r.Disponivel)
                        {
                            @* O único relatório que existe é gerado na tela de Vulnerabilidades —
                               mandar pra lá em vez de exibir um "Gerar" que não gera nada. *@
                            <a asp-page="/Vulnerabilidades" class="oi-report-gen" style="text-decoration:none;">@I18n.T("generate") →</a>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="oi-exec-card">
            @* Sem o selo "AI": o texto é montado por consulta ao banco, não gerado por modelo.
               Alegar IA aqui seria mais uma afirmação que não se sustenta. *@
            <div class="oi-panel-head">
                <span class="oi-panel-title" style="margin:0">@I18n.T("execPreview")</span>
            </div>
            <div class="oi-exec-body">
                <div class="oi-exec-period">@Model.PeriodoRotulo</div>
                <h3 class="oi-exec-head">@Model.ResumoTitulo</h3>
                <p class="oi-exec-text">@Model.ResumoTexto</p>
                <div class="oi-exec-stats">
                    @foreach (var e in Model.ExecStats)
                    {
                        <div class="oi-exec-stat">
                            <div class="oi-exec-stat-k">@e.Chave</div>
                            <div class="oi-exec-stat-v" style="color:@e.Cor">@e.Valor</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .oi-relmes { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:18px; padding:14px 16px; background:rgba(8,14,24,.6); border:1px solid rgba(120,170,255,.16); border-radius:12px; }
    .oi-relmes-tit { font-size:12px; text-transform:uppercase; letter-spacing:.1em; color:#8A96AB; margin-right:6px; }
    .oi-relmes select { background:rgba(5,10,18,.7); border:1px solid rgba(120,170,255,.16); border-radius:8px; padding:7px 10px; color:#EAF0F8; font-family:inherit; font-size:12.5px; }
    .oi-relmes button { background:#0B45DD; border:1px solid #3D7BFF; color:#fff; border-radius:8px; padding:7px 16px; font-family:inherit; font-size:12.5px; font-weight:600; cursor:pointer; }
    .oi-relmes button:hover { background:#0A3AB8; }
    .oi-relmes-nota { font-size:11px; color:#8A96AB; }
</style>
