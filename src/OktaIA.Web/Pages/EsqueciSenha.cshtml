@page
@model EsqueciSenhaModel
@{
    Layout = null;
    ViewData["Title"] = "Esqueci minha senha";
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Esqueci minha senha — L'okta IA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/brand/favicon-32.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/senha.css" asp-append-version="true" />
</head>
<body>
    <div class="oksenha-wrap">
        <div class="oksenha-card">
            <a href="/" class="oksenha-brand">
                <img src="~/img/brand/simbolo-solido-branco.svg" alt="L'okta IA" />
                <span><b>L'okta IA</b><small>Cyber Security &amp; AI</small></span>
            </a>

            <h1>Esqueci minha senha</h1>

            @if (Model.Enviado)
            {
                <div class="oksenha-ok">
                    Se houver uma conta com esse e-mail, enviamos o link para criar uma senha nova. Confira também o lixo eletrônico.
                </div>
                <a asp-page="/Login" class="oksenha-btn">Voltar ao login</a>
            }
            else
            {
                <p class="oksenha-sub">Informe o e-mail da sua conta. Enviaremos um link para você criar uma senha nova.</p>

                @if (Model.Erro is not null)
                {
                    <div class="oksenha-erro"><span></span>@Model.Erro</div>
                }

                <form method="post">
                    <label class="oksenha-label">E-mail corporativo</label>
                    <input asp-for="Email" type="email" required autocomplete="email" placeholder="nome@suaempresa.com.br" class="oksenha-input" />
                    <button type="submit" class="oksenha-btn">Enviar link</button>
                </form>
                <p class="oksenha-foot"><a asp-page="/Login">Voltar ao login</a></p>
            }
        </div>
    </div>
</body>
</html>
