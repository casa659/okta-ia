@page "/"
@model IndexModel
@using OktaIA.Web.Services
@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "Home";
}

<section style="max-width:1280px; margin:0 auto; padding:clamp(52px,7vw,96px) clamp(16px,4vw,32px) clamp(44px,5vw,72px); display:grid; grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr)); gap:64px; align-items:center; min-height:76vh;">
  <div>
    <div style="display:inline-flex; align-items:center; gap:9px; border:1px solid rgba(77,155,255,.26); background:rgba(77,155,255,.07); border-radius:100px; padding:6px 14px; margin-bottom:26px;">
      <span style="width:6px; height:6px; border-radius:50%; background:#00E0A4; box-shadow:0 0 10px #00E0A4;"></span>
      <span class="mk-mono" style="font-size:10.5px; letter-spacing:.14em; text-transform:uppercase; color:#9CC4FF;">SOC as a Service · MSSP · Inteligência Artificial</span>
    </div>
    <h1 class="mk-h1" style="font-size:clamp(38px,4.4vw,62px); line-height:1.05;">
      Segurança contínua para<br>organizações que <span style="background:linear-gradient(100deg,#4D9BFF,#00E0A4); -webkit-background-clip:text; background-clip:text; color:transparent;">não podem parar</span>
    </h1>
    <p class="mk-lead" style="margin-bottom:34px;">Plataforma unificada de Cyber Security que monitora infraestrutura, aplicações, APIs e usuários em tempo real — com Inteligência Artificial correlacionando eventos, priorizando riscos e recomendando a resposta antes que o incidente vire prejuízo.</p>
    <div style="display:flex; gap:12px; flex-wrap:wrap; margin-bottom:40px;">
      <a asp-page="/Contato" class="mk-btn-primary">Solicitar demonstração</a>
      <a asp-page="/Contato" class="mk-btn-secondary">Falar com especialista</a>
    </div>
    <div class="mk-mono" style="display:flex; align-items:center; gap:26px; flex-wrap:wrap; font-size:10.5px; letter-spacing:.1em; text-transform:uppercase; color:#5A7191;">
      <span>ISO 27001</span><span style="color:#22334D;">·</span><span>ISO 27701</span><span style="color:#22334D;">·</span><span>NIST CSF</span><span style="color:#22334D;">·</span><span>LGPD</span><span style="color:#22334D;">·</span><span>MITRE ATT&amp;CK</span>
    </div>
  </div>

  <div style="position:relative;">
    <div style="position:relative; background:linear-gradient(160deg,rgba(255,255,255,.055),rgba(255,255,255,.015)); border:1px solid rgba(120,170,255,.16); border-radius:18px; padding:16px; backdrop-filter:blur(14px); box-shadow:0 32px 80px rgba(0,0,0,.55);">
      <div style="display:flex; align-items:center; gap:8px; padding:2px 4px 13px;">
        <span style="width:7px; height:7px; border-radius:50%; background:#FF5F57;"></span>
        <span style="width:7px; height:7px; border-radius:50%; background:#FEBC2E;"></span>
        <span style="width:7px; height:7px; border-radius:50%; background:#28C840;"></span>
        <span class="mk-mono" style="margin-left:8px; font-size:9.5px; color:#5A7191;">okta-ia.com/soc · tempo real</span>
      </div>
      <div style="background:#070C15; border:1px solid rgba(120,170,255,.10); border-radius:12px; overflow:hidden;">
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(288px,100%),1fr)); gap:1px; background:rgba(120,170,255,.09);">
          <div style="background:#080E18; padding:12px 13px;">
            <div class="mk-mono" style="font-size:8.5px; color:#5A7191; letter-spacing:.1em; margin-bottom:6px;">EVENTOS 24H</div>
            <div class="mk-mono" style="font-size:19px; font-weight:600; color:#4D9BFF;">128.437</div>
          </div>
          <div style="background:#080E18; padding:12px 13px;">
            <div class="mk-mono" style="font-size:8.5px; color:#5A7191; letter-spacing:.1em; margin-bottom:6px;">BLOQUEADOS</div>
            <div class="mk-mono" style="font-size:19px; font-weight:600; color:#00E0A4;">99,6%</div>
          </div>
          <div style="background:#080E18; padding:12px 13px;">
            <div class="mk-mono" style="font-size:8.5px; color:#5A7191; letter-spacing:.1em; margin-bottom:6px;">INCIDENTES</div>
            <div class="mk-mono" style="font-size:19px; font-weight:600; color:#FF8A3D;">5</div>
          </div>
        </div>
        <div class="mk-map-host" data-mk-map='@MarketingContent.MapDataJson()' data-mk-map-live style="height:216px; border-top:1px solid rgba(120,170,255,.09);"></div>
        <div style="border-top:1px solid rgba(120,170,255,.09); max-height:132px; overflow:hidden;">
          @foreach (var f in MarketingContent.HeroFeed)
          {
            <div style="display:flex; align-items:center; gap:9px; padding:8px 13px; border-bottom:1px solid rgba(120,170,255,.055);">
              <span style="width:6px; height:6px; border-radius:50%; flex:0 0 6px; background:@f.Color;"></span>
              <span style="font-size:11px; color:#C4D3E6; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@f.Type</span>
              <span class="mk-mono" style="font-size:9.5px; color:#5A7191;">@f.Cc</span>
              <span class="mk-mono" style="font-size:9.5px; color:#00E0A4;">BLOQUEADO</span>
            </div>
          }
        </div>
      </div>
    </div>
  </div>
</section>

<section style="border-top:1px solid rgba(120,170,255,.09); border-bottom:1px solid rgba(120,170,255,.09); background:rgba(8,14,24,.6);">
  <div style="max-width:1280px; margin:0 auto; padding:clamp(28px,4vw,44px) clamp(16px,4vw,32px); display:grid; grid-template-columns:repeat(auto-fit,minmax(min(212px,100%),1fr)); gap:32px;">
    <div>
      <div class="mk-mono" style="font-size:clamp(26px,2.6vw,34px); font-weight:600; color:#EAF0F8; letter-spacing:-.02em;"><span data-mk-counter="2.4" data-mk-decimals="1">0</span> bi</div>
      <div style="font-size:12.5px; color:#7A8FAB; margin-top:5px;">eventos analisados por mês</div>
    </div>
    <div>
      <div class="mk-mono" style="font-size:clamp(26px,2.6vw,34px); font-weight:600; color:#EAF0F8; letter-spacing:-.02em;"><span data-mk-counter="99.98" data-mk-decimals="2">0</span>%</div>
      <div style="font-size:12.5px; color:#7A8FAB; margin-top:5px;">disponibilidade contratual</div>
    </div>
    <div>
      <div class="mk-mono" style="font-size:clamp(26px,2.6vw,34px); font-weight:600; color:#EAF0F8; letter-spacing:-.02em;"><span data-mk-counter="3.2" data-mk-decimals="1">0</span> min</div>
      <div style="font-size:12.5px; color:#7A8FAB; margin-top:5px;">tempo médio de detecção</div>
    </div>
    <div>
      <div class="mk-mono" style="font-size:clamp(26px,2.6vw,34px); font-weight:600; color:#EAF0F8; letter-spacing:-.02em;">5</div>
      <div style="font-size:12.5px; color:#7A8FAB; margin-top:5px;">serviços integrados numa operação só</div>
    </div>
  </div>
</section>

<section class="mk-section">
  <div class="mk-lede-block" style="max-width:760px;">
    <span class="mk-kicker">Por que a Okta-IA</span>
    <h2 class="mk-h2" style="font-size:clamp(28px,3.4vw,42px);">Transformamos dezenas de ferramentas de segurança em uma visão única, inteligente e orientada ao negócio</h2>
    <p class="mk-lead">Enquanto o firewall protege o perímetro, o EDR protege os endpoints e o SIEM correlaciona eventos, a Okta-IA conecta tudo isso: prioriza riscos com Inteligência Artificial, gera relatórios executivos, mede conformidade e orienta a tomada de decisão. Não substituímos as ferramentas que sua empresa já tem — nós as orquestramos numa visão só.</p>
  </div>
  <div class="mk-grid-4">
    @foreach (var l in MarketingContent.Layers)
    {
      <div class="mk-card" style="padding:26px 22px;">
        <div class="mk-card-num" style="color:#4D9BFF;">@l.N</div>
        <h3 class="mk-card-title" style="font-size:16px;">@l.T</h3>
        <p class="mk-card-body" style="margin-bottom:0;">@l.D</p>
      </div>
    }
  </div>
</section>

<section class="mk-section mk-section-bordered">
  <div class="mk-lede-block" style="max-width:660px;">
    <span class="mk-kicker">O que fazemos</span>
    <h2 class="mk-h2" style="font-size:clamp(28px,3.4vw,42px);">Os 5 pilares do nosso SOC as a Service</h2>
    <p class="mk-lead">Agregamos tecnologias líderes de mercado — SIEM, XDR, scanners, threat intel — sob uma operação gerenciada só, com licenciamento otimizado. Você contrata o serviço, não a infraestrutura por trás dele.</p>
  </div>
  <div class="mk-grid-3">
    <div class="mk-card">
      <div class="mk-card-num" style="color:#4D9BFF;">01</div>
      <h3 class="mk-card-title">Monitoramento</h3>
      <p class="mk-card-body">SIEM e XDR de parceiros integrados correlacionando logs de servidores, firewalls, nuvem, containers e endpoints, com IA classificando alertas por prioridade real.</p>
      <div class="mk-tag-row"><span class="mk-tag">SIEM</span><span class="mk-tag">XDR</span><span class="mk-tag">IA</span></div>
    </div>
    <div class="mk-card">
      <div class="mk-card-num" style="color:#00E0A4;">02</div>
      <h3 class="mk-card-title">Resposta</h3>
      <p class="mk-card-body">Contenção dos casos de alta confiança e escalonamento com SLA de primeira resposta a partir de 15 minutos, seguindo o plano de ação definido em contrato.</p>
      <div class="mk-tag-row"><span class="mk-tag">SOAR</span><span class="mk-tag">SLA</span><span class="mk-tag">ESCALONAMENTO</span></div>
    </div>
    <div class="mk-card">
      <div class="mk-card-num" style="color:#8A7BFF;">03</div>
      <h3 class="mk-card-title">Relatórios</h3>
      <p class="mk-card-body">Trilha de auditoria imutável, inventário de ativos e evidências prontas para ISO 27001, NIST CSF e LGPD, com relatórios executivos gerados para a diretoria e o conselho.</p>
      <div class="mk-tag-row"><span class="mk-tag">AUDITORIA</span><span class="mk-tag">LGPD</span><span class="mk-tag">ISO 27001</span></div>
    </div>
    <div class="mk-card">
      <div class="mk-card-num" style="color:#FFC93C;">04</div>
      <h3 class="mk-card-title">Consultoria</h3>
      <p class="mk-card-body">Diagnóstico de maturidade, priorização de risco e reunião periódica com especialistas para orientar o roadmap de segurança — não só o produto, a estratégia por trás dele.</p>
      <div class="mk-tag-row"><span class="mk-tag">RISCO</span><span class="mk-tag">ROADMAP</span><span class="mk-tag">ESPECIALISTAS</span></div>
    </div>
    <div class="mk-card">
      <div class="mk-card-num" style="color:#FF8A3D;">05</div>
      <h3 class="mk-card-title">Gestão</h3>
      <p class="mk-card-body">Administração contínua das ferramentas licenciadas — regras, políticas, patches e integrações — para que sua equipe não precise operar cada tecnologia isoladamente.</p>
      <div class="mk-tag-row"><span class="mk-tag">PATCH</span><span class="mk-tag">POLÍTICAS</span><span class="mk-tag">INTEGRAÇÕES</span></div>
    </div>
  </div>
</section>

<section class="mk-section-shaded">
  <div style="max-width:1280px; margin:0 auto; padding:clamp(48px,6vw,88px) clamp(16px,4vw,32px); display:grid; grid-template-columns:repeat(auto-fit,minmax(min(400px,100%),1fr)); gap:56px; align-items:center;">
    <div>
      <span class="mk-kicker">Cobertura global</span>
      <h2 class="mk-h2" style="font-size:clamp(26px,3vw,38px);">Ameaças não respeitam fuso horário</h2>
      <p class="mk-lead" style="margin-bottom:26px;">Nossa telemetria observa tráfego hostil originado de mais de 140 países. Cada tentativa alimenta os modelos que protegem toda a base de clientes — o que um cliente sofre hoje, os demais já bloqueiam amanhã.</p>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
        <div style="border-left:2px solid #4D9BFF; padding-left:14px;">
          <div class="mk-mono" style="font-size:22px; font-weight:600;">5</div>
          <div style="font-size:12.5px; color:#7A8FAB; margin-top:3px;">regiões de datacenter</div>
        </div>
        <div style="border-left:2px solid #00E0A4; padding-left:14px;">
          <div class="mk-mono" style="font-size:22px; font-weight:600;">140+</div>
          <div style="font-size:12.5px; color:#7A8FAB; margin-top:3px;">países na telemetria</div>
        </div>
      </div>
    </div>
    <div style="background:linear-gradient(160deg,rgba(255,255,255,.04),rgba(255,255,255,.01)); border:1px solid rgba(120,170,255,.13); border-radius:18px; padding:14px; backdrop-filter:blur(10px);">
      <div class="mk-map-host" data-mk-map='@MarketingContent.MapDataJson()' data-mk-map-live style="height:376px; border-radius:12px; overflow:hidden;"></div>
    </div>
  </div>
</section>

<section class="mk-section">
  <div class="mk-lede-block" style="max-width:640px;">
    <span class="mk-kicker">Diferenciais</span>
    <h2 class="mk-h2" style="font-size:clamp(28px,3.4vw,42px);">Por que organizações críticas escolhem a okta-ia</h2>
  </div>
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(196px,100%),1fr)); gap:14px;">
    @foreach (var d in MarketingContent.Diffs)
    {
      <div style="background:rgba(255,255,255,.028); border:1px solid rgba(120,170,255,.11); border-radius:13px; padding:20px 18px;">
        <div class="mk-mono" style="font-size:10px; color:#4D9BFF; letter-spacing:.12em; margin-bottom:12px;">@d.N</div>
        <div style="font-size:14px; font-weight:600; margin-bottom:7px; letter-spacing:-.01em;">@d.T</div>
        <div style="font-size:12.5px; line-height:1.6; color:#7A8FAB;">@d.D</div>
      </div>
    }
  </div>
</section>

<section class="mk-section-shaded">
  <div style="max-width:1280px; margin:0 auto; padding:clamp(38px,5vw,60px) clamp(16px,4vw,32px);">
    <div class="mk-mono" style="text-align:center; font-size:10.5px; letter-spacing:.18em; text-transform:uppercase; color:#5A7191; margin-bottom:32px;">Confiança de organizações em setores regulados</div>
    <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(148px,100%),1fr)); gap:18px; align-items:center;">
      @foreach (var c in MarketingContent.Clients)
      {
        <div style="text-align:center; font-size:14.5px; font-weight:600; color:#43556F; letter-spacing:-.01em; padding:14px 8px; border:1px solid rgba(120,170,255,.07); border-radius:10px;">@c.N</div>
      }
    </div>
  </div>
</section>

<section class="mk-section">
  <div style="position:relative; overflow:hidden; background:linear-gradient(135deg,rgba(77,155,255,.13),rgba(0,224,164,.06)); border:1px solid rgba(120,170,255,.22); border-radius:22px; padding:64px 56px; text-align:center;">
    <h2 class="mk-h2" style="font-size:clamp(26px,3.2vw,38px);">Avalie sua superfície de ataque em 15 dias</h2>
    <p style="margin:0 auto 30px; max-width:580px; font-size:15.5px; line-height:1.7; color:#9DB0C8;">Ativamos a plataforma em ambiente real, mapeamos seus ativos expostos e entregamos um diagnóstico executivo — sem compromisso de contratação.</p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a asp-page="/Contato" class="mk-btn-primary">Solicitar demonstração</a>
      <a asp-page="/Plataforma" class="mk-btn-secondary">Conhecer a plataforma</a>
    </div>
  </div>
</section>

@section Scripts {
    <script src="~/lib/d3/d3.min.js"></script>
    <script src="~/lib/d3/topojson-client.min.js"></script>
    <script src="~/js/marketing-map.js" asp-append-version="true"></script>
}
