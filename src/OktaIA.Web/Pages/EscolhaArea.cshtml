@page
@model EscolhaAreaModel
@{
    Layout = null;
    ViewData["Title"] = "Escolha sua área";
}
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Escolha sua área — okta-ia</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/brand/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/brand/apple-touch-icon-180.png" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div style="min-height:100vh; display:flex; align-items:center; justify-content:center; padding:20px;">
        <div style="width:100%; max-width:400px;">
            <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
                <div style="width:40px; height:40px; border-radius:50%; background:linear-gradient(145deg,#1F3350,#16243A); border:1px solid rgba(120,170,255,.2); display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:600; color:#8FC0FF;">@Model.Iniciais</div>
                <div style="line-height:1.25;">
                    <div style="font-size:15px; font-weight:600; color:var(--oi-text);">@Model.NomeCompleto</div>
                    <div class="oi-mono" style="font-size:10.5px; color:var(--oi-muted-2);">@Model.Email</div>
                </div>
            </div>
            <h2 style="margin:0 0 7px; font-size:22px; font-weight:600; letter-spacing:-.024em; color:var(--oi-text);">Escolha sua área</h2>
            <p style="margin:0 0 24px; font-size:13.5px; color:var(--oi-muted);">Seu perfil tem acesso a duas áreas.</p>

            <div style="display:flex; flex-direction:column; gap:11px;">
                <a asp-page="/Dashboard" style="display:block; background:linear-gradient(160deg,rgba(255,59,92,.07),rgba(255,255,255,.015)); border:1px solid rgba(255,59,92,.22); border-radius:13px; padding:20px 22px; color:var(--oi-text); text-decoration:none;">
                    <div style="display:flex; align-items:center; gap:9px; margin-bottom:8px;">
                        <span style="width:7px; height:7px; border-radius:50%; background:#FF3B5C;"></span>
                        <span style="font-size:16px; font-weight:600; letter-spacing:-.016em;">Centro de Operações · SOC</span>
                        <span class="oi-mono" style="margin-left:auto; font-size:9.5px; color:#FF8098; background:rgba(255,59,92,.10); border-radius:5px; padding:3px 7px;">5 ABERTOS</span>
                    </div>
                    <p style="margin:0; font-size:13px; line-height:1.6; color:var(--oi-muted);">Dashboard em tempo real, incidentes, SIEM, vulnerabilidades e copiloto de IA.</p>
                </a>

                <a asp-page="/Admin/Index" style="display:block; background:linear-gradient(160deg,rgba(77,155,255,.07),rgba(255,255,255,.015)); border:1px solid rgba(77,155,255,.22); border-radius:13px; padding:20px 22px; color:var(--oi-text); text-decoration:none;">
                    <div style="display:flex; align-items:center; gap:9px; margin-bottom:8px;">
                        <span style="width:7px; height:7px; border-radius:50%; background:#4D9BFF;"></span>
                        <span style="font-size:16px; font-weight:600; letter-spacing:-.016em;">Administração</span>
                        <span class="oi-mono" style="margin-left:auto; font-size:9.5px; color:#8FC0FF; background:rgba(77,155,255,.10); border-radius:5px; padding:3px 7px;">SUPER ADMIN</span>
                    </div>
                    <p style="margin:0; font-size:13px; line-height:1.6; color:var(--oi-muted);">Empresas, usuários, perfis e permissões, integrações, faturamento e auditoria.</p>
                </a>
            </div>

            <form method="post" asp-page="/Login" asp-page-handler="Logout" style="margin-top:18px;">
                <button type="submit" style="width:100%; background:none; border:none; padding:10px; font-family:inherit; font-size:12.5px; color:var(--oi-muted-2); cursor:pointer;">Sair da conta</button>
            </form>
        </div>
    </div>
</body>
</html>
