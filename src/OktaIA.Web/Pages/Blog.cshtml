@page
@model BlogModel
@using OktaIA.Web.Services
@{
    Layout = "_MarketingLayout";
    ViewData["Title"] = "Blog";
}

<section class="mk-section-tight" style="padding-top:80px; padding-bottom:48px;">
  <span class="mk-kicker">Conteúdo</span>
  <h1 class="mk-h1" style="max-width:820px;">Análises técnicas, sem sensacionalismo</h1>
  <p class="mk-lead" style="max-width:680px;">O que nossa equipe observa na operação, traduzido para quem decide.</p>
</section>

<section style="max-width:1280px; margin:0 auto; padding:0 clamp(16px,4vw,32px) 40px;">
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(288px,100%),1fr)); gap:18px;">
    @foreach (var p in MarketingContent.PostsFeatured)
    {
      <div style="background:rgba(255,255,255,.028); border:1px solid rgba(120,170,255,.11); border-radius:15px; overflow:hidden;">
        <div style="height:168px; position:relative; background:linear-gradient(150deg,@(p.C)22,#0A1120);"></div>
        <div style="padding:22px 22px 24px;">
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:12px;">
            <span class="mk-mono" style="font-size:9.5px; color:@p.C; border:1px solid @p.B; border-radius:5px; padding:3px 8px; letter-spacing:.1em;">@p.Tag</span>
            <span class="mk-mono" style="font-size:9.5px; color:#43556F;">@p.Date</span>
          </div>
          <div style="font-size:16.5px; font-weight:600; line-height:1.34; margin-bottom:10px; letter-spacing:-.016em;">@p.T</div>
          <p style="margin:0; font-size:13.5px; line-height:1.66; color:#8296B0;">@p.D</p>
        </div>
      </div>
    }
  </div>
</section>

<section style="max-width:1280px; margin:0 auto; padding:0 clamp(16px,4vw,32px) clamp(50px,6vw,88px);">
  <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(288px,100%),1fr)); gap:14px;">
    @foreach (var p in MarketingContent.PostsList)
    {
      <div style="display:flex; gap:16px; align-items:flex-start; background:rgba(255,255,255,.022); border:1px solid rgba(120,170,255,.09); border-radius:12px; padding:18px 20px;">
        <span class="mk-mono" style="font-size:9.5px; color:@p.C; margin-top:3px; flex:0 0 auto;">@p.Tag</span>
        <div>
          <div style="font-size:14px; font-weight:600; line-height:1.4; margin-bottom:5px; letter-spacing:-.012em;">@p.T</div>
          <div class="mk-mono" style="font-size:9.5px; color:#43556F;">@p.Date</div>
        </div>
      </div>
    }
  </div>
</section>
